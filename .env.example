# Copier ce fichier vers .env puis adapter les valeurs.
#   cp .env.example .env
#
# Generer les deux secrets Airflow :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- API marketplace simulee ---------------------------------------------
# Token attendu dans l'en-tete 'Authorization: Bearer <token>'.
MARKETPLACE_API_TOKEN=changeme-token-api
# Port publie sur la machine hote. Le sujet prevoit 5000, mais macOS
# l'occupe deja (ControlCenter / Recepteur AirPlay). Le port interne du
# conteneur reste 5000 : les DAGs appellent bien http://api-simulee:5000.
API_PORT=5001
# Injecte des chutes de ventes et des prix aberrants dans les donnees
# generees, pour alimenter la detection d'anomalies de la partie 2.
API_INJECT_ANOMALIES=true

# --- PostgreSQL : base de metadonnees Airflow ----------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=changeme-airflow-db
AIRFLOW_DB_NAME=airflow

# --- PostgreSQL : Data Warehouse -----------------------------------------
DWH_USER=marketplace
DWH_PASSWORD=changeme-dwh
DWH_DB=marketplace
# Port expose sur la machine hote. Le sujet prevoit 5433 ; le changer en
# cas de conflit avec un autre PostgreSQL deja en ecoute sur ce port.
DWH_HOST_PORT=5433
# Taux de commission marketplace applique au CA eligibile (paid/shipped/delivered).
MARKETPLACE_COMMISSION_RATE=0.12

# --- MinIO ----------------------------------------------------------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_RAW_BUCKET=raw

# --- Airflow --------------------------------------------------------------
AIRFLOW_PORT=8080
# Identifiants de l'UI : utilisateur 'admin', mot de passe ci-dessous.
AIRFLOW_ADMIN_PASSWORD=changeme-admin
AIRFLOW_FERNET_KEY=changeme-fernet-key
AIRFLOW_JWT_SECRET=changeme-jwt-secret
# Webhook facultatif pour les alertes de baisse du CA et les echecs de DAG.
AIRFLOW_ALERT_WEBHOOK_URL=

# --- Metabase -------------------------------------------------------------
METABASE_PORT=3000
# Base applicative de Metabase, creee sur l'instance postgres-dwh.
# Distincte de DWH_DB : Metabase n'ecrit jamais dans les donnees metier.
METABASE_DB=metabase
# Local development account used by dashboards/publish_metabase_dashboard.py.
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=
